    {
      "id": "s40",
      "title": "Why we start with empty miles",
      "blocks": [
        {
          "type": "paragraph",
          "text": "A quarter of all truck kilometres in Europe are driven empty. For a small carrier the return leg decides whether a route makes money, so that is where the platform starts."
        },
        {
          "type": "points",
          "items": [
            {
              "text": "Fuel is the largest cost of a route"
            },
            {
              "text": "Empty legs still pay the driver"
            },
            {
              "text": "A matched return load costs nothing extra"
            }
          ]
        }
      ]
    },
