{
  "name": "presentation_builder",
  "version": "0.0.0",
  "private": true,
  "description": "Brand input -> mood -> generated presentation, with its own slide engine, renderer and editor.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest",
    "test:e2e": "caffeinate -d -u -i npx jest -c jest.e2e.config.cjs",
    "lint": "eslint . --ext .js,.jsx,.cjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:ui": "npm run build -w @pb/ui",
    "dev:ui": "npm run dev -w @pb/ui",
    "serve:ui": "node packages/ui/server.js --port 8100",
    "api:ui": "node packages/ui/server.js --api-only --port 8101",
    "cli": "node packages/cli/bin/pb.js",
    "catalogue:index": "node scripts/catalogue-index.mjs && prettier --write --ignore-path .gitignore golden/catalogue/index.json",
    "catalogue:geometry": "caffeinate -d -u -i node scripts/catalogue-geometry.mjs && prettier --write --ignore-path .gitignore golden/catalogue/geometry.json",
    "catalogue:layouts": "node scripts/catalogue-layouts.mjs && prettier --write --ignore-path .gitignore packages/layouts/data/catalogue-layouts.json",
    "vocabulary:docs": "node scripts/vocabulary-docs.mjs && prettier --write --ignore-path .gitignore packages/vocabulary/__tests__/fixtures/answer-key.json"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.0"
  }
}
