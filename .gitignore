node_modules/
# generated output; the folder itself is kept via .gitkeep
/out/*
!/out/.gitkeep
golden/brands/
dist/
.cache/
*.log
.DS_Store

# the editor's per-user undo log (P4): runtime, never shared
content/history/

# a killed export run (older writer) could leave its temporary HTML next to the fixtures
packages/renderer/__fixtures__/.pb-export-*
